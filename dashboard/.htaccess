php_value post_max_size 200M
php_value upload_max_filesize 200M
php_value include_path ".:/var/www/dashboard/includes:/usr/share/php"

# /profile is the account and data-deletion URL given to Google Play; it stays valid when the beta dashboard takes over this host.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^profile/?$ /profile.php [R=302,L,QSA]
</IfModule>
