# ===== Static asset hosts =====

# VODs: local files on syd1 (VPC 10.240.0.9) then Mega S4 vods/ prefix.
# Named downloads use /{user}/{disk.mp4}/{title.mp4} so the last path
# segment is the saved filename. S4 keys stay vods/{user}/{disk.mp4}.
vods.botofthespecter.com {
    @named_vod path_regexp named_vod ^/([A-Za-z0-9_]+)/([^/]+\.mp4)/([^/]+\.mp4)$
    handle @named_vod {
        reverse_proxy 10.240.0.9:8092 {
            @missing status 404
            handle_response @missing {
                rewrite * {env.STORAGE_PREFIX}/vods/{re.named_vod.1}/{re.named_vod.2}
                reverse_proxy {env.STORAGE_HOST}:443 {
                    header_up Host {env.STORAGE_HOST}
                    transport http {
                        tls
                    }
                }
            }
        }
    }
    reverse_proxy 10.240.0.9:8092 {
        @missing status 404
        handle_response @missing {
            rewrite * {env.STORAGE_PREFIX}/vods{http.request.uri.path}
            reverse_proxy {env.STORAGE_HOST}:443 {
                header_up Host {env.STORAGE_HOST}
                transport http {
                    tls
                }
            }
        }
    }
    import security
    encode zstd gzip
    @mp4 path *.mp4
    header @mp4 Cache-Control "public, max-age=3600"
    header @mp4 Content-Type "video/mp4"
    log {
        output file /var/log/caddy/vods.log
    }
}

# The S4 fallback strips the origin's reflected CORS headers so they don't
# collide with the Access-Control-Allow-Origin set for the fonts below.
cdn.botofthespecter.com {
    import storage_origin cdn
    header /css/fontawesome* Access-Control-Allow-Origin "*"
    header /css/fontawesome* Access-Control-Allow-Methods "GET, OPTIONS"
    log {
        output file /var/log/caddy/cdn.log
    }
}

walkons.botofthespecter.com {
