# ===== Static asset hosts =====

cdn.botofthespecter.com {
    rewrite * {env.STORAGE_PREFIX}/cdn{uri}
    # own proxy block: strip the origin's reflected CORS header so it doesn't
    # collide with the Access-Control-Allow-Origin we set for the fonts below.
    reverse_proxy {env.STORAGE_HOST}:443 {
        header_up Host {env.STORAGE_HOST}
        transport http {
            tls
        }
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Methods
    }
    import security
    encode zstd gzip
    @assets path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.mp3 *.wav *.mp4 *.m4a *.ogg *.woff *.woff2 *.ttf
    header @assets Cache-Control "public, max-age=31536000, immutable"
    header /css/fontawesome* Access-Control-Allow-Origin "*"
    header /css/fontawesome* Access-Control-Allow-Methods "GET, OPTIONS"
    log {
        output file /var/log/caddy/cdn.log
    }
}

walkons.botofthespecter.com {
    rewrite * {env.STORAGE_PREFIX}/walkons{uri}
    import asset_origin
    log {
        output file /var/log/caddy/walkons.log
    }
}

# Unified per-channel media library (migrated streamers).
# Served from the rclone mount + capped VFS disk cache (not the S4 proxy).
media.botofthespecter.com {
    root * /var/www/media
    import hot_media_origin
    log {
        output file /var/log/caddy/media.log
    }
}

music.botspecter.com, music.botofthespecter.com {
    rewrite * {env.STORAGE_PREFIX}/usermusic{uri}
    import asset_origin
    log {
        output file /var/log/caddy/usermusic.log
    }
}

soundalerts.botofthespecter.com {
    root * /var/www/soundalerts
    import hot_media_origin
    log {
        output file /var/log/caddy/soundalerts.log
    }
}

# Ephemeral OpenAI TTS clips from the websocket host (written under /var/www/tts,
# cleaned up after playback). These are temporary — do NOT proxy to Mega S4.
tts.botofthespecter.com {
    root * /var/www/tts
    file_server
    encode zstd gzip
    import security
    @mp3 path *.mp3
    # Short cache: files are deleted shortly after play; avoid long CDN-style caching.
    header @mp3 Cache-Control "public, max-age=120, must-revalidate"
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, OPTIONS"
    log {
        output file /var/log/caddy/tts.log
    }
}

videoalerts.botofthespecter.com {
    root * /var/www/videoalerts
    import hot_media_origin
    log {
        output file /var/log/caddy/videoalerts.log
    }
}

# Wildcard catch-all for botofthespecter.com subdomains that don't have their
# own block above (e.g. web1 - the server's own hostname). Exact-host blocks
# always win; only unmatched subdomains land here. The wildcard cert is issued
# via the global Cloudflare DNS-01 config (wildcards require DNS-01).
*.botofthespecter.com {
    root * /var/www/html
    import php_app
    log {
        output file /var/log/caddy/wildcard-botofthespecter.log
    }
}

# Fallback for unrouted subdomains and direct IP access
* {
    root * /var/www/html
    import php_app
    log {
        output file /var/log/caddy/fallback.log
    }
}
