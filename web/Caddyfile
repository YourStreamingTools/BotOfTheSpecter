# BotOfTheSpecter - Caddy config for the web server.
#
# Covers PHP frontends + static asset hosts (Mega S4 durable assets + local TTS).
# Caddy auto-issues + auto-renews Let's Encrypt certs.
#
# Wildcards (*.specterbot.app, *.yourlinks.click) use Cloudflare DNS-01;
# everything else uses HTTP-01 automatically.
#
# Reload with:   systemctl reload caddy
# Watch logs:    journalctl -fu caddy

{
    email admin@botofthespecter.com

    # All five zones (botofthespecter.com, botspecter.com, yourlinks.click,
    # specterbot.app, yourstreamingtools.com) are on Cloudflare, so use DNS-01
    # globally. Works for
    # wildcards AND apex domains, and survives Cloudflare proxy being on.
    acme_dns cloudflare {env.CF_API_TOKEN}
}

# ===== Reusable snippets =====

(security) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

(php_app) {
    @blocked {
        path *.conf *.env *.sql *.md *.ini *.log /database.php
    }
    handle @blocked {
        respond 403
    }
    php_fastcgi unix//run/php/php8.5-fpm.sock
    encode zstd gzip
    file_server
    import security
}

(static_long_cache) {
    file_server
    encode zstd gzip
    import security
    @assets path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.mp3 *.wav *.mp4 *.m4a *.woff *.woff2 *.ttf
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# Durable media hosts are served by the storage server (syd1, VPC 10.240.0.9) from
# its cached read-only Mega S4 mounts (specter-media-mount@<store>, storage_http.py).
# Usage: import storage_origin <store>. A 404/503 there (a file uploaded seconds ago,
# or a store that is down) and an unreachable storage server fall back to S4 directly.
# web1 keeps no media read cache; dashboard uploads still write to S4 via its rclone mounts.
(storage_fallback) {
    rewrite * {env.STORAGE_PREFIX}/{args[0]}{http.request.orig_uri}
    reverse_proxy {env.STORAGE_HOST}:443 {
        header_up Host {env.STORAGE_HOST}
        header_down -Access-Control-Allow-Origin
        header_down -Access-Control-Allow-Methods
        transport http {
            tls
        }
    }
}

(storage_origin) {
    # The store root is not an object. Answer here so a probe does not wait on
    # syd1 and then Mega S4 (NoSuchKey, about 1–3s) and does not reveal the bucket.
    @store_root path /
    handle @store_root {
        header Cache-Control "public, max-age=60"
        respond "Not found" 404
    }
    handle {
        rewrite * /media/{args[0]}{uri}
        # HEAD is answered by the storage server only: S4's public URL returns 400 to
        # HEAD, which would turn a missing file's 404 into a 400 (bots probe walk-ons
        # with HEAD). Unreachable storage still falls back via handle_errors.
        @head method HEAD
        reverse_proxy @head 10.240.0.9:8092
        reverse_proxy 10.240.0.9:8092 {
            @fallback status 404 503
            handle_response @fallback {
                import storage_fallback {args[0]}
            }
        }
    }
    handle_errors 502 503 504 {
        import storage_fallback {args[0]}
    }
    import security
    encode zstd gzip
    @assets path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.mp3 *.wav *.mp4 *.m4a *.ogg *.woff *.woff2 *.ttf
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# ===== PHP frontends =====

botofthespecter.com, www.botofthespecter.com {
    root * /var/www/home
    import php_app
    log {
        output file /var/log/caddy/botofthespecter.log
    }
}

dashboard.botofthespecter.com {
    # Old /admin bookmarks → admin host (strip /admin). Do not execute PHP here.
    redir /admin https://admin.botofthespecter.com/ 308
    handle_path /admin/* {
        redir https://admin.botofthespecter.com{uri} 308
    }
    handle {
        root * /var/www/dashboard
        redir /favicon.ico https://cdn.botofthespecter.com/favicon.ico permanent
        import php_app
    }
    log {
        output file /var/log/caddy/dashboard.log
    }
}

admin.botofthespecter.com {
    # Operator panel. PHP files stay on disk under dashboard/admin/ so
    # ../includes and admin_access.php still resolve. Browser /css /js /api
    # are the dashboard copies on this host (no cross-subdomain stylesheets).
    handle /css/* {
        root * /var/www/dashboard
        file_server
        encode zstd gzip
        import security
    }
    handle /js/* {
        root * /var/www/dashboard
        file_server
        encode zstd gzip
        import security
    }
    handle /api/* {
        root * /var/www/dashboard
        php_fastcgi unix//run/php/php8.5-fpm.sock
        encode zstd gzip
        import security
    }
    handle {
        root * /var/www/dashboard/admin
        import php_app
    }
    log {
        output file /var/log/caddy/admin.log
    }
}

members.botofthespecter.com {
    root * /var/www/members
    import php_app
    log {
        output file /var/log/caddy/members.log
    }
}

overlay.botofthespecter.com {
    root * /var/www/overlay
