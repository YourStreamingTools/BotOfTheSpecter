# BotOfTheSpecter - Caddy config for the web server.
#
# Covers PHP frontends + static asset hosts (Mega S4 durable assets + local TTS).
# Caddy auto-issues + auto-renews Let's Encrypt certs.
#
# Wildcards (*.specterbot.app, *.yourlinks.click) use Cloudflare DNS-01;
# everything else uses HTTP-01 automatically.
#
# Reload with:   systemctl reload caddy
# Watch logs:    journalctl -fu caddy

{
    email admin@botofthespecter.com

    # All five zones (botofthespecter.com, botspecter.com, yourlinks.click,
    # specterbot.app, yourstreamingtools.com) are on Cloudflare, so use DNS-01
    # globally. Works for
    # wildcards AND apex domains, and survives Cloudflare proxy being on.
    acme_dns cloudflare {env.CF_API_TOKEN}
}

# ===== Reusable snippets =====

(security) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

(php_app) {
    @blocked {
        path *.conf *.env *.sql *.md *.ini *.log /database.php
    }
    handle @blocked {
        respond 403
    }
    php_fastcgi unix//run/php/php8.5-fpm.sock
    encode zstd gzip
    file_server
    import security
}

(static_long_cache) {
    file_server
    encode zstd gzip
    import security
    @assets path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.mp3 *.wav *.mp4 *.m4a *.woff *.woff2 *.ttf
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# Static asset hosts proxy to the object-storage origin (STORAGE_HOST /
# STORAGE_PREFIX from caddy.env); each host appends its bucket prefix.
(asset_origin) {
    reverse_proxy {env.STORAGE_HOST}:443 {
        header_up Host {env.STORAGE_HOST}
        transport http {
            tls
        }
    }
    import security
    @assets path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.mp3 *.wav *.mp4 *.m4a *.ogg *.woff *.woff2 *.ttf
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# Hot mp3/mp4 hosts (soundalerts, videoalerts, media) serve off the rclone
# mount with a capped VFS disk cache. Do not use this for cdn — keep cdn on S4.
(hot_media_origin) {
    file_server
    encode zstd gzip
    import security
    @assets path *.jpg *.jpeg *.png *.gif *.webp *.svg *.ico *.css *.js *.mp3 *.wav *.mp4 *.m4a *.ogg *.woff *.woff2 *.ttf
    header @assets Cache-Control "public, max-age=31536000, immutable"
}

# ===== PHP frontends =====

botofthespecter.com, www.botofthespecter.com {
    root * /var/www/home
    import php_app
    log {
        output file /var/log/caddy/botofthespecter.log
    }
}

dashboard.botofthespecter.com {
    # Old /admin bookmarks → admin host (strip /admin). Do not execute PHP here.
    redir /admin https://admin.botofthespecter.com/ 308
    handle_path /admin/* {
        redir https://admin.botofthespecter.com{uri} 308
    }
    handle {
        root * /var/www/dashboard
        redir /favicon.ico https://cdn.botofthespecter.com/favicon.ico permanent
        import php_app
    }
    log {
        output file /var/log/caddy/dashboard.log
    }
}

admin.botofthespecter.com {
    # Operator panel. PHP files stay on disk under dashboard/admin/ so
    # ../includes and admin_access.php still resolve. Browser /css /js /api
    # are the dashboard copies on this host (no cross-subdomain stylesheets).
    handle /css/* {
        root * /var/www/dashboard
        file_server
        encode zstd gzip
        import security
    }
    handle /js/* {
        root * /var/www/dashboard
        file_server
        encode zstd gzip
        import security
    }
    handle /api/* {
        root * /var/www/dashboard
        php_fastcgi unix//run/php/php8.5-fpm.sock
        encode zstd gzip
        import security
    }
    handle {
        root * /var/www/dashboard/admin
        import php_app
    }
    log {
        output file /var/log/caddy/admin.log
    }
}

members.botofthespecter.com {
    root * /var/www/members
    import php_app
    log {
        output file /var/log/caddy/members.log
    }
}

overlay.botofthespecter.com {
    root * /var/www/overlay
    import php_app
    log {
        output file /var/log/caddy/overlay.log
    }
}

help.botofthespecter.com {
    redir https://support.botofthespecter.com{uri} permanent
}

support.botofthespecter.com {
    # Old help.botofthespecter.com paths 308 here via the help host.
    # Map the retired PHP filenames onto the static support guides.
    redir /setup.php /index.php#setup permanent
    redir /spotify_setup.php /index.php#spotify permanent
    redir /tts_setup.php /index.php#tts permanent
    redir /obs_audio_monitoring.php /index.php#obs-audio permanent
    redir /custom_variables.php /index.php#variables permanent
    redir /specter_module_variables.php /index.php#variables permanent
    redir /twitch_channel_points.php /index.php#twitch-channel-points permanent
    redir /custom_api.php /index.php#api permanent
    redir /run_yourself.php /index.php#run-yourself permanent
    redir /command_reference.php /index.php#commands permanent
    redir /faq.php /index.php#faq permanent
    redir /troubleshooting.php /index.php#troubleshooting permanent
    redir /search.php /index.php permanent
    redir /markdown.php https://support.discord.com/hc/en-us/articles/210298617 permanent

    root * /var/www/support
    import php_app
    log {
        output file /var/log/caddy/support.log
    }
}

roadmap.botofthespecter.com {
    root * /var/www/roadmap
    import php_app
    log {
        output file /var/log/caddy/roadmap.log
    }
}

# Apex + www serve the landing page directly from the /home/ subdirectory.
# Using /home/ as the docroot (not /var/www/specterbotapp) means relative
# asset paths in the landing page HTML resolve naturally.
specterbot.app, www.specterbot.app {
    root * /var/www/specterbotapp/home
    import php_app
    log {
        output file /var/log/caddy/specterbotapp.log
    }
}

# Per-user subdomains: docroot embeds the leftmost host label, so
# gfaundead.specterbot.app -> /var/www/specterbotapp/gfaundead/.
# No rewrite needed -- avoids the trailing-slash + index.php path bug
# that hits when both the URI ends with / and php_fastcgi appends /index.php.
# If the user dir doesn't exist (or any path under it 404s), handle_errors
# bounces the visitor to the apex.
*.specterbot.app {
    root * /var/www/specterbotapp/{labels.2}

    handle_errors {
        @404 expression {http.error.status_code} == 404
        redir @404 https://specterbot.app/
    }

    import php_app
    log {
        output file /var/log/caddy/specterbotapp-users.log
    }
}

specterbot.systems, www.specterbot.systems {
    root * /var/www/specterbotsystems

    # Redirect /mybot/* to mybot.specterbot.systems subdomain
    @mybot path /mybot /mybot/*
    handle @mybot {
        uri strip_prefix /mybot
        redir https://mybot.specterbot.systems{uri} 301
    }

    import php_app
    log {
        output file /var/log/caddy/specterbot-systems.log
    }
}

mybot.specterbot.systems {
    root * /var/www/specterbotsystems/mybot
    import php_app
    log {
        output file /var/log/caddy/mybot-specterbot-systems.log
    }
}

yourchat.botofthespecter.com {
    root * /var/www/yourchat
    import php_app
    log {
        output file /var/log/caddy/yourchat.log
    }
}

# YourLinks.click - the apex is the app/dashboard, served normally. The wildcard
# subdomains (username.yourlinks.click) are public profiles + short links, all
# dispatched through redirect.php, which reads the username from the Host header.
# This replaces the app's Apache .htaccess mod_rewrite rules - Caddy never reads
# .htaccess, which is why every subdomain was falling through to index.php.
yourlinks.click {
    root * /var/www/yourlinks.click
    import php_app
    log {
        output file /var/log/caddy/yourlinks.log
    }
}

# www → apex. Without this, redirect.php sends www to "/" on the same host and
# loops, because the wildcard block below routes "/" back into redirect.php.
www.yourlinks.click {
    redir https://yourlinks.click{uri} permanent
}

*.yourlinks.click {
    root * /var/www/yourlinks.click

    # "/" on a subdomain is the linktree / Twitch-redirect landing page.
    @root path /
    rewrite @root /redirect.php

    # "/<linkname>" that is not a real static file is a short link. redirect.php
    # still sees the original REQUEST_URI (Caddy preserves it across rewrites),
    # so it extracts the link name and Host-based username just like mod_rewrite.
    @shortlink {
        not path /redirect.php*
        not file
    }
    rewrite @shortlink /redirect.php

    import php_app
    log {
        output file /var/log/caddy/yourlinks.log
    }
}

yourstreamingtools.com, www.yourstreamingtools.com {
    root * /var/www/YourStreamingTools
    import php_app
    log {
        output file /var/log/caddy/yourstreamingtools.log
