# Ephemeral OpenAI TTS clips from the websocket host (written under /var/www/tts,
# cleaned up after playback). These are temporary — do NOT proxy to Mega S4.
tts.botofthespecter.com {
    root * /var/www/tts
    file_server
    encode zstd gzip
    import security
    @mp3 path *.mp3
    # Short cache: files are deleted shortly after play; avoid long CDN-style caching.
    header @mp3 Cache-Control "public, max-age=120, must-revalidate"
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, OPTIONS"
    log {
        output file /var/log/caddy/tts.log
    }
}

videoalerts.botofthespecter.com {
    import storage_origin videoalerts
    log {
        output file /var/log/caddy/videoalerts.log
    }
}

# *.botofthespecter.com is one label only, so *.webhook never matches that cert
# and the handshake fails. DNS for the zone is grey-cloud (not proxied), so
# clients verify this origin cert. Same placeholder site as other unmatched hosts.
# The only stream host is syd1.stream.botofthespecter.com, on the storage server.
*.webhook.botofthespecter.com {
    root * /var/www/html
    import php_app
    log {
        output file /var/log/caddy/multilevel.log
    }
}

# Wildcard catch-all for botofthespecter.com subdomains that don't have their
# own block above (e.g. web1 - the server's own hostname). Exact-host blocks
# always win; only unmatched subdomains land here. The wildcard cert is issued
# via the global Cloudflare DNS-01 config (wildcards require DNS-01).
*.botofthespecter.com {
    root * /var/www/html
    import php_app
    log {
        output file /var/log/caddy/wildcard-botofthespecter.log
    }
}

# Fallback for unrouted subdomains and direct IP access
* {
    root * /var/www/html
    import php_app
    log {
        output file /var/log/caddy/fallback.log
    }
}
