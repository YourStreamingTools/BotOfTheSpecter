[Unit]
Description=Specter user S3 VOD copier (one queued job)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/specter-stream
EnvironmentFile=/opt/specter-stream/.env
ExecStart=/opt/specter-stream/venv/bin/python /opt/specter-stream/s3_vod_uploader.py
Nice=10
KillMode=process
TimeoutStartSec=infinity
