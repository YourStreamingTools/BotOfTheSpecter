# BotOfTheSpecter - Caddy config for the WebSocket host.
#
# Terminates TLS for websocket.botofthespecter.com and reverse-proxies
# (including Socket.IO WebSocket upgrade) to the app on 127.0.0.1:8080.
#
# Reload with:   systemctl reload caddy
# Watch logs:    journalctl -fu caddy

{
    email admin@botofthespecter.com
}

(security) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

websocket.botofthespecter.com {
    # Docs explorer assets (css/js). Caddy runs as user `caddy` and often cannot
    # read /home/botofthespecter (mode 700) → 403. Keep a copy under /var/www.
    # Deploy: rsync host_api/docs_ui/ → /var/www/websocket-control-docs/
    # Strips /control/docs-static so /css/docs.css maps into that root.
    handle_path /control/docs-static/* {
        root * /var/www/websocket-control-docs
        file_server
    }
    # Private host control API (bots-api style) — strip /control prefix
    handle_path /control/* {
        reverse_proxy 127.0.0.1:8093
    }
    # Socket.IO + /health + /notify + /clients
    handle {
        reverse_proxy 127.0.0.1:8080
    }
    import security
    log {
        output file /var/log/caddy/websocket.log
    }
}
