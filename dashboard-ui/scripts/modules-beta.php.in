
// ---- Beta API (scripts/modules-beta.php.in, appended by sync-live-api.sh) ----
function beta_md_out(array $body, int $code = 200): never {
    while (ob_get_level() > 0) { ob_end_clean(); }
    http_response_code($code); header('Content-Type: application/json'); header('Cache-Control: no-store');
    echo json_encode($body, JSON_INVALID_UTF8_SUBSTITUTE); exit();
}
function beta_md_fail(string $msg, int $code = 400): never { beta_md_out(['success' => false, 'error' => $msg], $code); }
function beta_md_ok(string $msg, array $extra = []): never { beta_md_out(['success' => true, 'message' => $msg] + $extra); }
function beta_md_str(string $k, int $max, bool $req = false): string {
    $v = $_POST[$k] ?? '';
    if (!is_string($v)) beta_md_fail('Invalid value.');
    $v = trim($v);
    if ($req && $v === '') beta_md_fail('This field is required.');
    if (mb_strlen($v) > $max) beta_md_fail("Keep it to $max characters or fewer.");
    return $v;
}
function beta_md_int(string $k, int $min, int $max): int {
    $v = $_POST[$k] ?? '';
    if (!is_string($v) || !preg_match('/^-?\d{1,7}$/', trim($v))) beta_md_fail('Enter a whole number.');
    $n = (int) $v;
    if ($n < $min || $n > $max) beta_md_fail("Enter a number from $min to $max.");
    return $n;
}
function beta_md_enum(string $k, array $ok): string {
    $v = $_POST[$k] ?? null;
    if (!is_string($v) || !in_array($v, $ok, true)) beta_md_fail('Invalid choice.');
    return $v;
}
function beta_md_bool(string $k): int { return beta_md_enum($k, ['0', '1']) === '1' ? 1 : 0; }
function beta_md_list(string $k, int $maxItems): array {
    $v = json_decode((string) ($_POST[$k] ?? ''), true);
    if (!is_array($v) || count($v) > $maxItems || array_filter($v, fn($x) => !is_string($x))) beta_md_fail('Invalid list.');
    return array_values($v);
}
function beta_md_exec(mysqli $db, string $sql, string $types = '', array $args = []): int {
    $stmt = $db->prepare($sql);
    if (!$stmt) { error_log('beta modules prepare: ' . $db->error); beta_md_fail('Could not save right now. Try again.', 500); }
    if ($types !== '') $stmt->bind_param($types, ...$args);
    if (!$stmt->execute()) { error_log('beta modules exec: ' . $stmt->error); $stmt->close(); beta_md_fail('Could not save right now. Try again.', 500); }
    $n = $stmt->affected_rows; $stmt->close();
    return $n;
}
function beta_md_count(mysqli $db, string $sql, string $v): int {
    $stmt = $db->prepare($sql); $stmt->bind_param('s', $v); $stmt->execute();
    $n = (int) ($stmt->get_result()->fetch_row()[0] ?? 0); $stmt->close();
    return $n;
}
// Same matching as api/check_spam_pattern.php.
function beta_md_spam(string $s): bool {
    global $db_servername, $db_username, $db_password;
    $spam = new mysqli($db_servername, $db_username, $db_password, 'spam_pattern');
    if ($spam->connect_error) beta_md_fail('Could not check that right now. Try again.', 500);
    $res = $spam->query("SELECT spam_pattern FROM spam_patterns");
    $hit = false;
    while ($res && ($row = $res->fetch_assoc())) {
        if (preg_match('/' . preg_quote((string) $row['spam_pattern'], '/') . '/i', $s)) { $hit = true; break; }
    }
    $spam->close();
    return $hit;
}
// Same rules as api/check_blocked_term.php.
function beta_md_term_problem(mysqli $db, string $term): ?string {
    if (beta_md_spam($term)) return t('check_blocked_term_msg_spam_pattern');
    foreach ([['link_whitelist', 'check_blocked_term_msg_whitelist'], ['link_blacklisting', 'check_blocked_term_msg_blacklist']] as [$tbl, $msg]) {
        $res = $db->query("SELECT link FROM `$tbl`");
        while ($res && ($row = $res->fetch_assoc())) {
            $l = (string) $row['link'];
            if ($l !== '' && (stripos($l, $term) !== false || stripos($term, $l) !== false)) return t($msg);
        }
    }
    return null;
}
function beta_md_sound_dir(string $username): string { return "/var/www/soundalerts/$username/twitch"; }
function beta_md_sound_file(string $username, $name): string {
    if (!is_string($name) || $name === '' || $name !== basename($name) || $name[0] === '.' || !preg_match('/\.mp3$/i', $name)) beta_md_fail('Unknown sound file.');
    if (!is_file(beta_md_sound_dir($username) . '/' . $name)) beta_md_fail('That sound file no longer exists.');
    return $name;
}

$isActAsUser = isset($isActAs) && $isActAs === true;
$method = $_SERVER['REQUEST_METHOD'] ?? 'GET';

if ($method === 'GET') {
    $q = array_keys($_GET);
    if ($q === []) {
        try { $p = modules_build_list_payload($db, $conn, $user_id, $username); }
        catch (Throwable $e) { error_log('beta modules list: ' . $e->getMessage()); beta_md_fail('Specter Modules could not load right now.', 500); }
        $p['act_as'] = $isActAsUser;
        $p['default_chat_alerts'] = modules_default_chat_alerts();
        $p['max_upload_mb'] = 10;
        beta_md_out($p);
    }
    if ($q === ['voices'] && $_GET['voices'] === '1') {
        $v = modules_expressive_voices();
        beta_md_out(['success' => true, 'voices' => $v, 'default' => modules_default_expressive_voice_id($v)]);
    }
    if ($q === ['part'] && $_GET['part'] === 'shoutouts') {
        try { $p = modules_build_list_payload($db, $conn, $user_id, $username); }
        catch (Throwable $e) { error_log('beta modules shoutouts: ' . $e->getMessage()); beta_md_fail('Could not refresh cooldowns.', 500); }
        beta_md_out(['success' => true, 'shoutouts' => $p['shoutouts'] ?? ['cooldown_minutes' => 60, 'tracking' => []]]);
    }
    beta_md_fail('Unknown action.');
}
if ($method !== 'POST' || $_GET) beta_md_fail('Unknown action.', 405);
if ($isActAsUser) beta_md_fail('Specter Modules changes are disabled while acting as another user.', 403);
if (($_SERVER['HTTP_X_REQUESTED_WITH'] ?? '') !== 'XMLHttpRequest') beta_md_fail('Bad request.', 400);

$action = $_POST['action'] ?? '';
$allowed = [
    'joke_status' => ['status'], 'joke_blacklist' => ['list'],
    'welcome_toggle' => ['on'], 'welcome_save' => ['section', 'new_msg', 'returning_msg'],
    'url_blocking' => ['on'], 'term_blocking' => ['on'], 'ban_monitored' => ['on'],
    'first_message' => ['on', 'mode', 'list'],
    'link_add' => ['list_name', 'link'], 'link_remove' => ['list_name', 'link'],
    'term_add' => ['term'], 'term_remove' => ['term'],
    'wr_save' => ['on', 'word', 'frequency', 'rate', 'cooldown'],
    'wr_word_add' => ['word'], 'wr_word_remove' => ['word'], 'wr_user_add' => ['user'], 'wr_user_remove' => ['user'],
    'game_add' => ['game'], 'game_remove' => ['game'],
    'ad_save' => ['ad_upcoming_message', 'ad_1min_message', 'ad_start_message', 'ad_end_message', 'ad_snoozed_message', 'raid_ad_snooze_message', 'enable_ad_notice', 'enable_upcoming_ad_message', 'enable_1min_ad_message', 'enable_start_ad_message', 'enable_end_ad_message', 'enable_snoozed_ad_message', 'enable_ai_ad_breaks', 'enable_raid_ad_snooze', 'raid_ad_snooze_window_minutes', 'enable_raid_ad_snooze_message'],
    'sound_upload' => [], 'sound_map' => ['file', 'event'], 'sound_delete' => ['list'], 'sound_rename' => ['file', 'new_name'],
    'chat_alerts_save' => ['section', 'values'],
    'shout_cooldown' => ['minutes'],
    'tts_save' => ['voice', 'language', 'style', 'expressive_voice'],
    'bot_resolve' => ['bot_username'], 'bot_add' => ['bot_username'], 'bot_remove' => ['record_id'],
    'spotify_save' => ['enabled', 'max_song_seconds', 'max_queue_length', 'per_viewer_limit', 'per_viewer_stream_limit'],
];
if (!is_string($action) || !isset($allowed[$action])) beta_md_fail('Unknown action.');
$keys = array_keys($_POST); sort($keys);
$want = array_merge(['action'], $allowed[$action]); sort($want);
if ($keys !== $want) beta_md_fail('Unexpected fields for this action.');

switch ($action) {
case 'joke_status':
    $s = beta_md_enum('status', ['Enabled', 'Disabled']);
    beta_md_exec($db, "UPDATE builtin_commands SET status = ? WHERE command = 'joke'", 's', [$s]);
    beta_md_ok(t('modules_joke_command_status_updated'));
case 'joke_blacklist':
    $cats = ['Miscellaneous', 'Coding', 'Development', 'Halloween', 'Pun', 'nsfw', 'religious', 'political', 'racist', 'sexist', 'dark', 'explicit'];
    $l = beta_md_list('list', count($cats));
    if (array_diff($l, $cats)) beta_md_fail('Unknown joke category.');
    $j = json_encode(array_values(array_intersect($cats, $l)));
    beta_md_exec($db, "UPDATE joke_settings SET blacklist = ? WHERE id = 1", 's', [$j]);
    beta_md_ok('Joke blacklist saved.');
case 'welcome_toggle':
    $on = beta_md_bool('on');
    beta_md_exec($db, "UPDATE streamer_preferences SET send_welcome_messages = ? WHERE id = 1", 'i', [$on]);
    beta_md_ok($on ? 'Welcome messages enabled.' : 'Welcome messages disabled.');
case 'welcome_save':
    $cols = ['regular-members' => ['new_default_welcome_message', 'default_welcome_message'], 'vip-members' => ['new_default_vip_welcome_message', 'default_vip_welcome_message'], 'moderators' => ['new_default_mod_welcome_message', 'default_mod_welcome_message']];
    $sec = beta_md_enum('section', array_keys($cols));
    [$c1, $c2] = $cols[$sec];
    $n = beta_md_str('new_msg', 500); $r = beta_md_str('returning_msg', 500);
    beta_md_exec($db, "UPDATE streamer_preferences SET `$c1` = ?, `$c2` = ? WHERE id = 1", 'ss', [$n, $r]);
    beta_md_ok('Welcome messages saved.');
case 'url_blocking': case 'term_blocking': case 'ban_monitored':
    $col = ['url_blocking' => 'url_blocking', 'term_blocking' => 'term_blocking', 'ban_monitored' => 'ban_monitored_users'][$action];
    $v = beta_md_enum('on', ['True', 'False']);
    beta_md_exec($db, "UPDATE protection SET `$col` = ?", 's', [$v]);
    beta_md_ok('Protection settings updated.');
case 'first_message':
    $v = beta_md_enum('on', ['True', 'False']);
    $mode = beta_md_enum('mode', ['all', 'selected']);
    $l = beta_md_list('list', 500); $m = [];
    foreach ($l as $c) { $c = ltrim(strtolower(trim($c)), '!'); if ($c === '') continue; if (!preg_match('/^[a-z0-9_\-]{1,50}$/', $c)) beta_md_fail('Invalid command name.'); $m[$c] = true; }
    if ($mode === 'selected' && !$m) beta_md_fail('Pick at least one command to block, or choose all commands.');
    $j = json_encode(array_keys($m), JSON_UNESCAPED_UNICODE);
    beta_md_exec($db, "UPDATE protection SET block_first_message_commands = ?, block_first_message_command_mode = ?, block_first_message_selected_commands = ?", 'sss', [$v, $mode, $j]);
    beta_md_ok('First message command blocking updated.');
case 'link_add':
    $ln = beta_md_enum('list_name', ['whitelist', 'blacklist']);
    $link = beta_md_str('link', 255, true);
    if (preg_match('/\s/', $link)) beta_md_fail('Links cannot contain spaces.');
    [$tbl, $other] = $ln === 'whitelist' ? ['link_whitelist', 'link_blacklisting'] : ['link_blacklisting', 'link_whitelist'];
    if ($ln === 'whitelist' && beta_md_spam($link)) beta_md_fail(t('modules_js_cant_whitelist_blocked'));
    if (beta_md_count($db, "SELECT COUNT(*) FROM `$other` WHERE link = ?", $link)) beta_md_fail(t($ln === 'whitelist' ? 'modules_js_url_already_blacklist' : 'modules_js_url_already_whitelist'));
    if (beta_md_count($db, "SELECT COUNT(*) FROM `$tbl` WHERE link = ?", $link)) beta_md_fail('That link is already on the list.');
    beta_md_exec($db, "INSERT INTO `$tbl` (link) VALUES (?)", 's', [$link]);
    beta_md_ok($ln === 'whitelist' ? 'Link added to the whitelist.' : 'Link added to the blacklist.');
case 'link_remove':
    $tbl = beta_md_enum('list_name', ['whitelist', 'blacklist']) === 'whitelist' ? 'link_whitelist' : 'link_blacklisting';
    $link = beta_md_str('link', 255, true);
    beta_md_exec($db, "DELETE FROM `$tbl` WHERE link = ?", 's', [$link]);
    beta_md_ok('Link removed.');
case 'term_add':
    $term = beta_md_str('term', 255, true);
    if ($p = beta_md_term_problem($db, $term)) beta_md_fail($p);
    if (beta_md_count($db, "SELECT COUNT(*) FROM blocked_terms WHERE term = ?", $term)) beta_md_fail('That term is already blocked.');
    beta_md_exec($db, "INSERT INTO blocked_terms (term) VALUES (?)", 's', [$term]);
    beta_md_ok('Term blocked.');
case 'term_remove':
    beta_md_exec($db, "DELETE FROM blocked_terms WHERE term = ?", 's', [beta_md_str('term', 255, true)]);
    beta_md_ok('Term removed.');
case 'wr_save':
    $on = beta_md_enum('on', ['True', 'False']);
    $w = strtolower(beta_md_str('word', 32, true));
    if (!preg_match('/^[a-z0-9]{2,32}$/', $w)) beta_md_fail('Use 2 to 32 lowercase letters or numbers, no spaces.');
    $f = beta_md_int('frequency', 5, 200); $r = beta_md_int('rate', 2, 50); $c = beta_md_int('cooldown', 10, 300);
    beta_md_exec($db, "UPDATE protection SET word_replace_enabled = ?, word_replace_word = ?, word_replace_frequency = ?, word_replace_rate = ?, word_replace_cooldown = ?", 'ssiii', [$on, $w, $f, $r, $c]);
    beta_md_ok('Word Replacer settings updated successfully.');
case 'wr_word_add': case 'wr_word_remove':
    $w = strtolower(beta_md_str('word', 100, true));
    if (preg_match('/\s/', $w)) beta_md_fail('Use a single word, no spaces.');
    if ($action === 'wr_word_add') { beta_md_exec($db, "INSERT IGNORE INTO word_replace_ignored_words (word) VALUES (?)", 's', [$w]); beta_md_ok('Word added to the ignored list.'); }
    beta_md_exec($db, "DELETE FROM word_replace_ignored_words WHERE word = ?", 's', [$w]);
    beta_md_ok('Word removed.');
case 'wr_user_add': case 'wr_user_remove':
    $u = ltrim(strtolower(beta_md_str('user', 26, true)), '@');
    if (!preg_match('/^[a-z0-9_]{1,25}$/', $u)) beta_md_fail('Enter a valid Twitch username.');
    if ($action === 'wr_user_add') { beta_md_exec($db, "INSERT IGNORE INTO word_replace_ignored_users (username, source) VALUES (?, 'dashboard')", 's', [$u]); beta_md_ok('User added to opted-out list.'); }
    beta_md_exec($db, "DELETE FROM word_replace_ignored_users WHERE username = ?", 's', [$u]);
    beta_md_ok('User removed from the opted-out list.');
case 'game_add': case 'game_remove':
    $g = beta_md_str('game', 100, true);
    if ($action === 'game_add') {
        if (beta_md_count($db, "SELECT COUNT(*) FROM game_deaths_settings WHERE game_name = ?", $g)) beta_md_fail('That game is already ignored.');
        beta_md_exec($db, "INSERT INTO game_deaths_settings (game_name) VALUES (?)", 's', [$g]);
        beta_md_ok('Game added to the ignore list.');
    }
    beta_md_exec($db, "DELETE FROM game_deaths_settings WHERE game_name = ?", 's', [$g]);
    beta_md_ok('Game removed from the ignore list.');
case 'ad_save':
    $m = []; foreach (['ad_upcoming_message', 'ad_1min_message', 'ad_start_message', 'ad_end_message', 'ad_snoozed_message'] as $k) $m[] = beta_md_str($k, 500);
    $e = []; foreach (['enable_ad_notice', 'enable_upcoming_ad_message', 'enable_1min_ad_message', 'enable_start_ad_message', 'enable_end_ad_message', 'enable_snoozed_ad_message', 'enable_ai_ad_breaks', 'enable_raid_ad_snooze'] as $k) $e[] = beta_md_bool($k);
    $win = beta_md_int('raid_ad_snooze_window_minutes', 1, 30);
    $rm = beta_md_bool('enable_raid_ad_snooze_message');
    $rmsg = beta_md_str('raid_ad_snooze_message', 500);
    $vals = array_merge($m, $e, [$win, $rm, $rmsg]);
    beta_md_exec($db, "INSERT INTO ad_notice_settings (id, ad_upcoming_message, ad_1min_message, ad_start_message, ad_end_message, ad_snoozed_message, enable_ad_notice, enable_upcoming_ad_message, enable_1min_ad_message, enable_start_ad_message, enable_end_ad_message, enable_snoozed_ad_message, enable_ai_ad_breaks, enable_raid_ad_snooze, raid_ad_snooze_window_minutes, enable_raid_ad_snooze_message, raid_ad_snooze_message) VALUES (1, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?) ON DUPLICATE KEY UPDATE ad_upcoming_message = ?, ad_1min_message = ?, ad_start_message = ?, ad_end_message = ?, ad_snoozed_message = ?, enable_ad_notice = ?, enable_upcoming_ad_message = ?, enable_1min_ad_message = ?, enable_start_ad_message = ?, enable_end_ad_message = ?, enable_snoozed_ad_message = ?, enable_ai_ad_breaks = ?, enable_raid_ad_snooze = ?, raid_ad_snooze_window_minutes = ?, enable_raid_ad_snooze_message = ?, raid_ad_snooze_message = ?", 'sssssiiiiiiiiiissssssiiiiiiiiiis', array_merge($vals, $vals));
    beta_md_ok('Ad notice settings saved.');
case 'sound_upload':
    require_once '/var/www/dashboard/includes/upload_helpers.php';
    include '/var/www/dashboard/includes/storage_used.php';
    $dir = beta_md_sound_dir($username);
    $f = $_FILES['file'] ?? null;
    if (count($_FILES) !== 1 || !is_array($f) || is_array($f['name'] ?? null)) beta_md_fail('Send one MP3 file per upload.');
    if (($f['error'] ?? 1) !== UPLOAD_ERR_OK || !is_uploaded_file($f['tmp_name'])) beta_md_fail('The upload did not arrive. Try again.');
    $size = (int) $f['size']; $cap = 10 * 1024 * 1024;
    if ($size <= 0 || $size > $cap || filesize($f['tmp_name']) > $cap) beta_md_fail('MP3 files must be 10 MB or smaller.');
    $ext = strtolower((string) pathinfo((string) $f['name'], PATHINFO_EXTENSION));
    if ($ext !== 'mp3' || !upload_validate_extension_and_mime($f['tmp_name'], $ext, ['mp3'])) beta_md_fail('Only MP3 audio files are allowed.');
    if (($current_storage_used ?? 0) + $size > ($max_storage_size ?? 0)) beta_md_fail('Not enough storage left for this file.');
    if (!is_dir($dir) && !@mkdir($dir, 0755, true)) beta_md_fail('Could not prepare your sound folder.', 500);
    $t = upload_unique_target($dir, upload_sanitize_filename((string) $f['name'], 'mp3'));
    if (!@move_uploaded_file($f['tmp_name'], $t['path'])) beta_md_fail('Could not save the file. Try again.', 500);
    @chmod($t['path'], 0644);
    beta_md_ok('Uploaded ' . $t['name'] . '.', ['file' => $t['name']]);
case 'sound_map':
    $file = beta_md_sound_file($username, $_POST['file']);
    $ev = beta_md_enum('event', ['', 'Follow', 'Raid', 'Cheer', 'Subscription', 'Gift Subscription', 'Hype Train Start', 'Hype Train End']);
    if ($ev === '') { beta_md_exec($db, "DELETE FROM twitch_sound_alerts WHERE sound_mapping = ?", 's', [$file]); beta_md_ok('Mapping removed.'); }
    $stmt = $db->prepare("SELECT COUNT(*) FROM twitch_sound_alerts WHERE twitch_alert_id = ? AND sound_mapping <> ?");
    $stmt->bind_param('ss', $ev, $file); $stmt->execute(); $taken = (int) $stmt->get_result()->fetch_row()[0]; $stmt->close();
    if ($taken) beta_md_fail('That event already has a sound. Remove its mapping first.');
    if (beta_md_count($db, "SELECT COUNT(*) FROM twitch_sound_alerts WHERE sound_mapping = ?", $file)) beta_md_exec($db, "UPDATE twitch_sound_alerts SET twitch_alert_id = ? WHERE sound_mapping = ?", 'ss', [$ev, $file]);
    else beta_md_exec($db, "INSERT INTO twitch_sound_alerts (sound_mapping, twitch_alert_id) VALUES (?, ?)", 'ss', [$file, $ev]);
    beta_md_ok('Sound mapped.');
case 'sound_delete':
    $l = beta_md_list('list', 200);
    if (!$l) beta_md_fail('Select at least one file.');
    $gone = 0;
    foreach ($l as $name) {
        $name = beta_md_sound_file($username, $name);
        beta_md_exec($db, "DELETE FROM twitch_sound_alerts WHERE sound_mapping = ?", 's', [$name]);
        if (@unlink(beta_md_sound_dir($username) . '/' . $name)) $gone++;
    }
    beta_md_ok($gone === 1 ? 'Deleted 1 file.' : "Deleted $gone files.");
case 'sound_rename':
    require_once '/var/www/dashboard/includes/upload_helpers.php';
    $file = beta_md_sound_file($username, $_POST['file']);
    $r = upload_rename_file(beta_md_sound_dir($username), $file, beta_md_str('new_name', 80, true), 'safe');
    if (empty($r['ok'])) beta_md_fail(t('upload_rename_' . (in_array($r['error'] ?? '', ['exists', 'invalid', 'missing', 'same'], true) ? $r['error'] : 'failed')));
    upload_rename_update_refs($db, $file, $r['new']);
    beta_md_ok(t('upload_rename_success'), ['file' => $r['new']]);
case 'chat_alerts_save':
    $secs = ['general' => ['follower_alert', 'cheer_alert', 'raid_alert'], 'subscription' => ['subscription_alert', 'gift_subscription_alert'], 'hype-train' => ['hype_train_start', 'hype_train_end'], 'beta' => ['gift_paid_upgrade', 'prime_paid_upgrade', 'pay_it_forward']];
    $sec = beta_md_enum('section', array_keys($secs));
    $v = json_decode((string) $_POST['values'], true);
    if (!is_array($v) || array_keys($v) !== $secs[$sec]) beta_md_fail('Invalid alert messages.');
    foreach ($v as $k => $msg) { if (!is_string($msg) || mb_strlen($msg) > 500) beta_md_fail('Keep each alert message to 500 characters or fewer.'); }
    foreach ($v as $k => $msg) {
        $msg = trim($msg);
        if (beta_md_count($db, "SELECT COUNT(*) FROM twitch_chat_alerts WHERE alert_type = ?", $k)) beta_md_exec($db, "UPDATE twitch_chat_alerts SET alert_message = ? WHERE alert_type = ?", 'ss', [$msg, $k]);
        else beta_md_exec($db, "INSERT INTO twitch_chat_alerts (alert_type, alert_message) VALUES (?, ?)", 'ss', [$k, $msg]);
    }
    beta_md_ok('Chat alerts saved.');
case 'shout_cooldown':
    $m = beta_md_int('minutes', 60, 10080);
    beta_md_exec($db, "INSERT INTO automated_shoutout_settings (id, cooldown_minutes) VALUES (1, ?) ON DUPLICATE KEY UPDATE cooldown_minutes = ?", 'ii', [$m, $m]);
    beta_md_ok('Shoutout cooldown saved.');
case 'tts_save':
    $voice = beta_md_enum('voice', ['Alloy', 'Ash', 'Ballad', 'Coral', 'Echo', 'Fable', 'Nova', 'Onyx', 'Sage', 'Shimmer', 'Verse']);
    $lang = beta_md_enum('language', ['en']);
    $style = beta_md_enum('style', ['normal', 'expressive']);
    $ex = beta_md_str('expressive_voice', 64);
    if ($ex !== '') {
        if (!preg_match('/^[A-Za-z0-9]{1,64}$/', $ex)) beta_md_fail('Unknown expressive voice.');
        $ids = array_column(modules_expressive_voices(), 'id');
        if ($ids && !in_array($ex, $ids, true)) beta_md_fail('Unknown expressive voice.');
    }
    beta_md_exec($db, "INSERT INTO tts_settings (id, voice, language, style, expressive_voice) VALUES (1, ?, ?, ?, ?) ON DUPLICATE KEY UPDATE voice = ?, language = ?, style = ?, expressive_voice = ?", 'ssssssss', [$voice, $lang, $style, $ex, $voice, $lang, $style, $ex]);
    beta_md_ok('TTS settings saved.');
case 'bot_resolve': case 'bot_add':
    $name = strtolower(ltrim(beta_md_str('bot_username', 26, true), '@'));
    if (!preg_match('/^[a-z0-9_]{3,25}$/', $name)) beta_md_fail('Enter a valid Twitch username.');
    include '/var/www/config/twitch.php';
    [$id, $err] = resolveModuleBotTwitchUserId($name);
    if ($id === false || !preg_match('/^\d{1,20}$/', (string) $id)) beta_md_fail($id === false && str_contains((string) $err, 'HTTP') ? 'Twitch did not answer. Try again.' : (string) ($err ?: 'Twitch user not found.'));
    if ($action === 'bot_resolve') beta_md_ok('Resolved.', ['id' => (string) $id]);
    $stmt = $conn->prepare("SELECT id FROM custom_module_bots WHERE channel_id = ? AND bot_username = ? LIMIT 1");
    $stmt->bind_param('is', $user_id, $name); $stmt->execute(); $stmt->store_result(); $dupe = $stmt->num_rows > 0; $stmt->close();
    if ($dupe) beta_md_fail(t('modules_err_bot_already_linked'));
    $idS = (string) $id;
    beta_md_exec($conn, "INSERT INTO custom_module_bots (channel_id, bot_username, bot_channel_id, is_verified, access_token, token_expires, refresh_token) VALUES (?, ?, ?, 0, '', NULL, NULL)", 'iss', [$user_id, $name, $idS]);
    beta_md_ok(t('modules_msg_bot_added'));
case 'bot_remove':
    $rid = beta_md_int('record_id', 1, 2147483647);
    if (!beta_md_exec($conn, "DELETE FROM custom_module_bots WHERE id = ? AND channel_id = ?", 'ii', [$rid, $user_id])) beta_md_fail('That bot is not linked to your channel.', 404);
    beta_md_ok(t('modules_msg_bot_removed'));
case 'spotify_save':
    $en = beta_md_bool('enabled');
    $mss = beta_md_int('max_song_seconds', 30, 7200); $mql = beta_md_int('max_queue_length', 1, 500);
    $pvl = beta_md_int('per_viewer_limit', 0, 500); $pvs = beta_md_int('per_viewer_stream_limit', 0, 5000);
    // Live adds this column on every save; beta only when it is missing.
    $col = $db->query("SHOW COLUMNS FROM media_request_settings LIKE 'per_viewer_stream_limit'");
    if ($col && $col->num_rows === 0) { try { $db->query("ALTER TABLE media_request_settings ADD COLUMN per_viewer_stream_limit INT NOT NULL DEFAULT 0"); } catch (Throwable $ignored) {} }
    beta_md_exec($db, "INSERT INTO media_request_settings (id, enabled, max_song_seconds, max_queue_length, per_viewer_limit, per_viewer_stream_limit) VALUES (1, ?, ?, ?, ?, ?) ON DUPLICATE KEY UPDATE enabled = VALUES(enabled), max_song_seconds = VALUES(max_song_seconds), max_queue_length = VALUES(max_queue_length), per_viewer_limit = VALUES(per_viewer_limit), per_viewer_stream_limit = VALUES(per_viewer_stream_limit)", 'iiiii', [$en, $mss, $mql, $pvl, $pvs]);
    beta_md_ok(t('modules_spotify_song_requests_success'));
}
beta_md_fail('Unknown action.');
