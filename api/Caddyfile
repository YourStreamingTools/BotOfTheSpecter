# BotOfTheSpecter - Caddy config for the product API host.
#
# Terminates TLS for api.botofthespecter.com and reverse-proxies to the
# public FastAPI app (api/api.py, systemd unit fastapi.service,
# bound to 127.0.0.1:8080 — see api/README.md).
#
# Single exact host, plain HTTP-01 automatic HTTPS — stock `apt install caddy`
# is enough (no Cloudflare DNS plugin). Port 80 must reach the origin for ACME
# (DNS-only / grey-cloud at Cloudflare is fine).
#
# Reload with:   systemctl reload caddy
# Watch logs:    journalctl -fu caddy

{
    email admin@botofthespecter.com
}

(security) {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
        -X-Powered-By
    }
}

# Access logs never keep credentials: keys in headers, query strings and the Referer become REDACTED.
(log_redact) {
    format filter {
        wrap json
        fields {
            request>headers>X-Api-Key replace REDACTED
            request>headers>X-Ws-Control-Key replace REDACTED
            request>headers>Referer regexp "(?i)([?&](code|api_key|admin_key|token|server_token|auth_data|password)=)[^&#]*" "${1}REDACTED"
            request>uri query {
                replace code REDACTED
                replace api_key REDACTED
                replace admin_key REDACTED
                replace token REDACTED
                replace server_token REDACTED
                replace auth_data REDACTED
                replace password REDACTED
            }
        }
    }
}

api.botofthespecter.com {
    reverse_proxy 127.0.0.1:8080
    import security
    log {
        output file /var/log/caddy/api.log
        import log_redact
    }
}
